{
  "expo": {
    "name": "MUEDnote",
    "slug": "muednote-mobile",
    "version": "1.0.0",
    "scheme": "muednote",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mued.muednote",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "音声認識のためにマイクを使用します",
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "3"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1a2e"
      },
      "package": "com.mued.muednote",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-av",
      "./plugins/withWhisperModel"
    ],
    "extra": {
      "eas": {
        "projectId": "d9c69c5e-bf40-4b59-b8a5-b2636336182d"
      }
    },
    "owner": "glasswerkskimny"
  }
}
