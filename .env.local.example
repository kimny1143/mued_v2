# Database
DATABASE_URL=your_neon_database_url

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Stripe Price IDs (Monthly)
NEXT_PUBLIC_STRIPE_PRICE_BASIC=price_basic_monthly
NEXT_PUBLIC_STRIPE_PRICE_PREMIUM=price_premium_monthly

# Stripe Price IDs (Yearly) - Save 2 months
NEXT_PUBLIC_STRIPE_PRICE_BASIC_YEARLY=price_basic_yearly
NEXT_PUBLIC_STRIPE_PRICE_PREMIUM_YEARLY=price_premium_yearly

# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5-mini

# Modal.com (MIDI-LLM)
MODAL_API_TOKEN=your_modal_api_token
MODAL_API_URL=https://your-modal-workspace.modal.run/midi-llm/generate
MIDI_LLM_ENABLED=true

# Email (Resend) — used for reservations and research beta welcome email
RESEND_API_KEY=your_resend_api_key

# Advisory storefront #8 (mued.jp/advisory intake)
# ADVISORY_MEET_URL — the ONE fixed Google Meet link (glasswerks.jp Workspace) embedded in the
#   booking .ics + confirmation email. kimny creates it once. When unset, bookings still record
#   (persist-first) but the confirmation email is skipped.
ADVISORY_MEET_URL=
# ADVISORY_NOTIFY_EMAIL — operator inbox for new booking/inquiry notifications (falls back to
#   GLASSWERKS_INQUIRY_EMAIL).
ADVISORY_NOTIFY_EMAIL=
# ADVISORY_CONSENT_POLICY_VERSION — recorded with each consent (e.g. advisory-2026-07).
# ADVISORY_CONSENT_POLICY_VERSION=advisory-2026-07
# INTERNAL_API_KEY — server-to-server auth for GET /api/advisory/kpi-monthly (insight課) and the
#   booking "mark conducted" token. Also used by the glasswerks notify route.
INTERNAL_API_KEY=
# GLASSWERKS_INQUIRY_EMAIL — existing operator inbox (advisory notify falls back to this).
GLASSWERKS_INQUIRY_EMAIL=

# Vercel Blob — research beta waitlist storage (set in Vercel dashboard → Storage → Blob → Tokens)
BLOB_READ_WRITE_TOKEN=

# Sentry
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Upstash Redis (Rate Limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Analytics
NEXT_PUBLIC_VERCEL_ENV=production
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# MUEDial Subscription Price IDs (Stripe Dashboard)
# Phase 6 案X: Hoo Pass $5.99/月
STRIPE_DIAL_HOO_PASS_PRICE_ID=price_dial_hoo_pass_monthly

# Research beta price-hiding flag (set to 'false' at Q3 GA to reveal prices)
NEXT_PUBLIC_RESEARCH_BETA=true
STRIPE_DIAL_BASIC_PRICE_ID=price_dial_basic_monthly
STRIPE_DIAL_PRO_PRICE_ID=price_dial_pro_monthly
STRIPE_DIAL_STUDIO_PRICE_ID=price_dial_studio_monthly

# MUEDial Credit Pack Price IDs (Stripe Dashboard)
STRIPE_DIAL_CREDIT_SMALL_PRICE_ID=price_dial_credit_small
STRIPE_DIAL_CREDIT_LARGE_PRICE_ID=price_dial_credit_large

# MUEDial Upload Proxy (Cloudflare Worker)
NEXT_PUBLIC_UPLOAD_PROXY_URL=https://muedial-upload-proxy.your-account.workers.dev

# RoEx Webhook URL (production only — dev uses httpbin.org/post fallback)
# ROEX_WEBHOOK_URL=https://dial.mued.jp/api/webhooks/roex
# ROEX_WEBHOOK_SECRET=your_random_secret_here

# MUEDial Bonus Campaign
# DIAL_BONUS_CAMPAIGN_MAX_COST_USD=1500
# OPERATOR_ALERT_EMAIL=kimny1143@gmail.com

# E2E Testing (development only)
# ENABLE_E2E_BYPASS=true

# Development Auth (開発環境のみ・本番では設定不要)
# DEV_AUTH_TOKEN=dev_token_your_secret
# DEV_USER_ID=your_dev_user_clerk_id
# DEV_USER_EMAIL=your_dev_email@example.com
