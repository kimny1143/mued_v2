# Database
DATABASE_URL=your_neon_database_url

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Stripe Price IDs (Monthly)
NEXT_PUBLIC_STRIPE_PRICE_BASIC=price_basic_monthly
NEXT_PUBLIC_STRIPE_PRICE_PREMIUM=price_premium_monthly

# Stripe Price IDs (Yearly) - Save 2 months
NEXT_PUBLIC_STRIPE_PRICE_BASIC_YEARLY=price_basic_yearly
NEXT_PUBLIC_STRIPE_PRICE_PREMIUM_YEARLY=price_premium_yearly

# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5-mini

# Modal.com (MIDI-LLM)
MODAL_API_TOKEN=your_modal_api_token
MODAL_API_URL=https://your-modal-workspace.modal.run/midi-llm/generate
MIDI_LLM_ENABLED=true

# Email (Resend) — used for reservations and research beta welcome email
RESEND_API_KEY=your_resend_api_key
# Self-owned marketing list: the Resend Segment id that granted-consent contacts sync into.
# audienceId === segmentId (same Resend id space). RESEND_MARKETING_SEGMENT_ID is preferred;
# RESEND_MARKETING_AUDIENCE_ID is honored as a backward-compat fallback. Unset = sync is a no-op
# (capture + marketing_consents ledger still write). See lib/marketing/audience-sync.ts.
RESEND_MARKETING_SEGMENT_ID=

# MUEDsat free-download gate (mued.jp/muedsat) — dedicated Resend audience for the plugin's
# email list, kept separate from the general marketing audience for clean segmentation.
# UNSET = no-op (the /api/muedsat/subscribe endpoint silently skips the audience add), so the
# staged LP builds and runs before the audience is provisioned. Set the real id at unlock.
# NOTE: the publish flip + the download/MUEDsp URLs are NOT env vars — they are consts in
# lib/muedsat/config.ts (MUEDSAT_LIVE / MUEDSAT_DOWNLOAD_URL / MUEDSAT_MUEDSP_URL), flipped in the
# reviewed unlock PR (they are imported by client components, so must be inlined literals).
RESEND_MUEDSAT_AUDIENCE_ID=

# Paid line — MUEDsp masterchain ($69). Dedicated Resend audiences, SEPARATE from the free-module
# lists (interest = pre-launch "notify me at launch"; buyers = $69 purchasers). No-op-safe while unset
# (interest capture / reflux webhook ship inert). Provisioned + set at the kimny-gated pre-launch /
# launch (design docs/paid-line/*). FASTSPRING_WEBHOOK_SECRET = HMAC-SHA256 secret for the C+ webhook.
RESEND_MASTERCHAIN_INTEREST_AUDIENCE_ID=
RESEND_MASTERCHAIN_BUYERS_AUDIENCE_ID=
FASTSPRING_WEBHOOK_SECRET=
# MASTERCHAIN_LICENSE_PRIVATE_KEY — Ed25519 PKCS#8 PEM. Signs the license keyfiles we issue.
#   ★This is NOT the webhook secret above. FASTSPRING_WEBHOOK_SECRET is a symmetric HMAC that answers
#   "did FastSpring send this?"; this key is asymmetric and answers "did WE issue this license?".
#   The matching PUBLIC key is compiled into the plugin, which verifies OFFLINE.
#   Unset ⇒ no license is issued and the order webhook returns non-2xx (fail-CLOSED, so FastSpring
#   retries rather than a buyer paying and receiving nothing). Never an "unsigned" license.
#   ★Verification is offline and there is no revocation: if this key leaks it cannot be recalled —
#   every shipped binary keeps trusting it. Recovery = re-issue to every buyer in
#   masterchain_purchases, then drop the old key in a new plugin build. Use separate test/prod keys.
#   Generate:  node -e "const{generateKeyPairSync}=require('crypto');const k=generateKeyPairSync('ed25519');console.log(k.privateKey.export({type:'pkcs8',format:'pem'}));console.log(k.publicKey.export({type:'spki',format:'pem'}))"
MASTERCHAIN_LICENSE_PRIVATE_KEY=
# MASTERCHAIN_LICENSE_PUBLIC_KEY — the matching public key. NOT a secret (it ships inside the plugin).
#   Set alongside the private key so CI/startup can prove the pair actually matches — see
#   scripts/verify/masterchain-license-selfcheck.mjs. Catches "the wrong key was pasted into Vercel"
#   here, instead of when a buyer reports that their key does not work.
MASTERCHAIN_LICENSE_PUBLIC_KEY=

# Advisory storefront #8 (mued.jp/advisory intake)
# ADVISORY_MEET_URL — the ONE fixed Google Meet link (glasswerks.jp Workspace) embedded in the
#   booking .ics + confirmation email. kimny creates it once. When unset, bookings still record
#   (persist-first) but the confirmation email is skipped.
ADVISORY_MEET_URL=
# ADVISORY_NOTIFY_EMAIL — operator inbox for new booking/inquiry notifications (falls back to
#   GLASSWERKS_INQUIRY_EMAIL).
ADVISORY_NOTIFY_EMAIL=
# ADVISORY_CONSENT_POLICY_VERSION — recorded with each consent (e.g. advisory-2026-07).
# ADVISORY_CONSENT_POLICY_VERSION=advisory-2026-07
# INTERNAL_API_KEY — server-to-server bearer for GET /api/advisory/kpi-monthly (insight課). Also
#   used by the glasswerks notify route.
INTERNAL_API_KEY=
# ADVISORY_BOOKING_TOKEN_SECRET — SEPARATE secret signing the booking "mark conducted" one-tap link
#   (kept apart from INTERNAL_API_KEY so a KPI-key holder can't forge a conducted token).
ADVISORY_BOOKING_TOKEN_SECRET=
# GLASSWERKS_INQUIRY_EMAIL — existing operator inbox (advisory notify falls back to this).
GLASSWERKS_INQUIRY_EMAIL=

# Vercel Blob — research beta waitlist storage (set in Vercel dashboard → Storage → Blob → Tokens)
BLOB_READ_WRITE_TOKEN=

# Sentry
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Upstash Redis (Rate Limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Analytics
NEXT_PUBLIC_VERCEL_ENV=production
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# MUEDial subscriptions: none. Hoo Pass was retired 2026-07 (#650) and the checkout route was
# deleted with it — there is no subscription price id to set. The `hoo_pass` tier still exists in
# lib/dial/pricing.ts and the dial_sub_tier enum, deliberately: the Stripe webhook and the rate-limit
# check read it for pre-existing subscribers, and a Postgres enum value cannot be dropped while rows
# may reference it. Retained ≠ purchasable.

# Research beta price-hiding flag (set to 'false' at Q3 GA to reveal prices)
NEXT_PUBLIC_RESEARCH_BETA=true
STRIPE_DIAL_BASIC_PRICE_ID=price_dial_basic_monthly
STRIPE_DIAL_PRO_PRICE_ID=price_dial_pro_monthly
STRIPE_DIAL_STUDIO_PRICE_ID=price_dial_studio_monthly

# MUEDial Credit Pack Price IDs (Stripe Dashboard)
STRIPE_DIAL_CREDIT_SMALL_PRICE_ID=price_dial_credit_small
STRIPE_DIAL_CREDIT_LARGE_PRICE_ID=price_dial_credit_large

# MUEDial Upload Proxy (Cloudflare Worker)
NEXT_PUBLIC_UPLOAD_PROXY_URL=https://muedial-upload-proxy.your-account.workers.dev

# RoEx Webhook URL (production only — dev uses httpbin.org/post fallback)
# ROEX_WEBHOOK_URL=https://dial.mued.jp/api/webhooks/roex
# ROEX_WEBHOOK_SECRET=your_random_secret_here

# MUEDial Bonus Campaign
# DIAL_BONUS_CAMPAIGN_MAX_COST_USD=1500
# OPERATOR_ALERT_EMAIL=kimny1143@gmail.com

# E2E Testing (development only)
# ENABLE_E2E_BYPASS=true

# Development Auth (開発環境のみ・本番では設定不要)
# DEV_AUTH_TOKEN=dev_token_your_secret
# DEV_USER_ID=your_dev_user_clerk_id
# DEV_USER_EMAIL=your_dev_email@example.com
