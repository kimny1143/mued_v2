# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
test-results.json

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
__pycache__/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.test

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
tests/reports/*.md

# Native apps (separate git repository)
apps/

# Docs assets (large binary files kept locally)
docs/assets/
docs/nanogen_images/

# Temporary/one-off scripts (dev-only, not for commit)
scripts/tmp/

# Claude Code symlinks (managed in claude-code-template repository)
# Ignore all, then whitelist MUED-specific files
.claude/commands/
.claude/agents/*
!.claude/agents/database-architect.md
!.claude/agents/mued-architect-manager.md
!.claude/agents/script-consolidator.md
.claude/skills/*
!.claude/skills/ai-models/
!.claude/skills/aio-seo/
!.claude/skills/database/
!.claude/skills/daw-osc/

# PWA Service Worker (generated by @serwist/next)
public/sw.js
public/sw.js.map
public/swe-worker-*.js

# Large binary files
*.ipa

# Remotion video projects (separate repository)
/videos/

