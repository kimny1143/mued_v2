# Vercel deploy ignore (mirrors .gitignore + extras for deploy size)

# dependencies
/node_modules
workers/*/node_modules
/.pnp
.pnp.*
.yarn/*

# testing
/coverage
/playwright-report
/test-results
test-results.json

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
__pycache__/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.test

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
tests/reports/*.md

# Native apps (separate repos, not needed for web deploy)
apps/

# Docs assets (large binaries)
docs/assets/
docs/nanogen_images/
docs/sunogen_audio/

# Temporary scripts
scripts/tmp/

# Claude Code config
.claude/

# PWA Service Worker (generated at build)
public/sw.js
public/sw.js.map
public/swe-worker-*.js

# Large binary files
*.ipa

# Remotion video projects
/videos/

# Workers (deployed separately via wrangler)
/workers/

# E2E tests (not needed at deploy)
/e2e/
